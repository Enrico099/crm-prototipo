# Copie para apps/api/.env e preencha. NUNCA versione o .env real.

# --- Database ---
# Postgres local (docker compose): as duas URLs são iguais.
DATABASE_URL="postgresql://crm:crm_dev_pwd@localhost:5432/crm?schema=public"
DIRECT_URL="postgresql://crm:crm_dev_pwd@localhost:5432/crm?schema=public"
#
# Supabase (Project Settings → Database → Connection string). Crie o projeto na
# região São Paulo (sa-east-1): são dados pessoais de clientes (LGPD).
#   DATABASE_URL = pooler em modo transação (porta 6543), usado pela API:
#     postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL = conexão de sessão (porta 5432), usada por migrate/seed:
#     postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# --- Redis (reservado — ainda não usado pela API) ---
REDIS_URL="redis://localhost:6379"

# --- App ---
NODE_ENV="development"
API_PORT=3333
# Origens do front (separadas por vírgula). Usado em CORS e na checagem de Origin (CSRF).
WEB_ORIGIN="http://localhost:3000"
# Express "trust proxy": IP real do cliente atrás do proxy do Next/LB (auditoria, rate limit)
TRUST_PROXY="loopback"
# Força cookie Secure fora de produção (ex.: staging com HTTPS). Em produção já é true.
# COOKIE_SECURE="true"

# --- Segredos ---
# Em produção: 32+ caracteres aleatórios, diferentes entre si. A API não sobe sem isso.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-change-me"
JWT_REFRESH_SECRET="dev-change-me-too"
# Pepper do HMAC do CPF (unicidade sem guardar o número). Obrigatório em produção.
# ATENÇÃO: trocar este valor depois que houver clientes cadastrados quebra a
# detecção de CPF duplicado para os registros existentes.
CPF_HASH_SECRET="dev-somente-local-cpf-hash-secret"

# --- AI Engine (microsserviço Python/FastAPI) ---
AI_ENGINE_URL="http://localhost:8000"
AI_ENGINE_TIMEOUT_MS=15000
# Token compartilhado API → AI Engine (mesmo valor em AI_ENGINE_TOKEN do serviço Python).
# Obrigatório em produção; opcional em dev.
# AI_ENGINE_TOKEN=""
