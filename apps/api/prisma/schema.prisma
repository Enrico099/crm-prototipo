// Capital Elite — CRM de Wealth Management
// Schema cobrindo: usuários (assessores), clientes, leads/pipeline, produtos,
// suitability, recomendações de IA, interações e trilha de auditoria.

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: conexão usada pela aplicação (no Supabase, a do pooler, porta 6543).
// DIRECT_URL: conexão direta usada pelas migrações (no Postgres local, a mesma URL).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// USUÁRIOS (assessores / admins do CRM)
// ============================================================

enum UserRole {
  ADMIN
  ASSESSOR
  COMPLIANCE
  READONLY
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  nome      String
  senhaHash String
  role      UserRole @default(ASSESSOR)
  ativo     Boolean  @default(true)

  mfaEnabled Boolean @default(false)
  // Segredo TOTP cifrado (AES-256-GCM, ver src/auth/mfa/cifra.ts), nunca em claro
  mfaSecret  String?
  // Último passo TOTP aceito: o mesmo código não vale duas vezes
  mfaUltimoPasso Int?
  mfaAtivadoEm   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientes      Cliente[]      @relation("ClienteResponsavel")
  leads         Lead[]         @relation("LeadResponsavel")
  interacoes    Interacao[]
  recomendacoes Recomendacao[] @relation("RecomendacaoAprovador")
  auditoria     Auditoria[]
  suitabilities Suitability[]  @relation("SuitabilityAplicador")
  refreshTokens RefreshToken[]
  movimentacoes Movimentacao[] @relation("MovimentacaoRegistradaPor")
  codigosRecuperacao CodigoRecuperacaoMfa[]

  // email já é @unique (índice implícito) — o @@index([email]) antigo era redundante
  @@map("users")
}

// Refresh tokens emitidos (um registro por jti). Permite rotação a cada uso,
// revogação no logout e detecção de reuso (token roubado reapresentado).
// familiaId agrupa a cadeia de rotações de uma mesma sessão de login.
model RefreshToken {
  id             String    @id // jti do JWT
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familiaId      String
  expiraEm       DateTime
  revogadoEm     DateTime?
  // jti que substituiu este na rotação (null = ainda é o token vigente da família)
  substituidoPor String?

  ip        String?
  userAgent String?
  criadoEm  DateTime @default(now())

  @@index([userId])
  @@index([familiaId])
  @@index([expiraEm])
  @@map("refresh_tokens")
}

// Códigos de recuperação do MFA (uso único). Só o hash é guardado; os códigos
// em claro aparecem uma única vez, na ativação ou na regeneração.
model CodigoRecuperacaoMfa {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash     String    @unique
  usadoEm  DateTime?
  criadoEm DateTime  @default(now())

  @@index([userId])
  @@map("mfa_codigos_recuperacao")
}

// ============================================================
// CLIENTES (carteira ativa do assessor)
// ============================================================

enum PerfilInvestidor {
  CONSERVADOR
  MODERADO
  ARROJADO
  AGRESSIVO
}

enum StatusCliente {
  ATIVO
  PROSPECTO
  INATIVO
  BLOQUEADO
}

model Cliente {
  id        String  @id @default(cuid())
  nome      String
  email     String  @unique
  telefone  String?
  cpfHash   String  @unique // hash do CPF — dado sensível LGPD
  cpfMasked String // ex: "***.***.123-45" para exibição

  cidade     String?
  uf         String?
  perfil     PerfilInvestidor @default(MODERADO)
  patrimonio Decimal          @default(0) @db.Decimal(18, 2)
  status     StatusCliente    @default(PROSPECTO)

  responsavelId String?
  responsavel   User?   @relation("ClienteResponsavel", fields: [responsavelId], references: [id])

  ultimaInteracao DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  suitability   Suitability[]
  recomendacoes Recomendacao[]
  interacoes    Interacao[]
  posicoes      Posicao[]
  leadOrigem    Lead? // lead que foi convertido neste cliente, se houver
  movimentacoes Movimentacao[]

  @@index([responsavelId, status])
  @@index([perfil])
  @@map("clientes")
}

// Carteira atual do cliente: quanto está alocado em cada produto.
// Usado pelo motor de IA para calcular diversificação e gaps.
model Posicao {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])
  valor     Decimal @db.Decimal(18, 2)

  adquiridoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([clienteId, produtoId])
  @@index([produtoId])
  // (clienteId já é coberto pelo prefixo do @@unique acima)
  @@map("posicoes")
}

// Movimentações da carteira: a posição é sempre a soma das movimentações do
// par cliente/produto (SALDO_INICIAL + APLICACAO − RESGATE). Valores a custo:
// o sistema não tem cotações, então não há marcação a mercado.
enum TipoMovimentacao {
  SALDO_INICIAL // posição que já existia antes do registro de movimentações
  APLICACAO
  RESGATE
}

model Movimentacao {
  id         String           @id @default(cuid())
  clienteId  String
  cliente    Cliente          @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  produtoId  String
  produto    Produto          @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  tipo       TipoMovimentacao
  valor      Decimal          @db.Decimal(18, 2) // sempre positivo; o tipo dá o sinal
  data       DateTime // data da operação (pode ser retroativa, nunca futura)
  observacao String?

  // Aplicação acima do perfil ou sem suitability válida, feita com ciência
  // registrada do cliente (CVM 30)
  desenquadrada Boolean @default(false)

  // Execução de uma recomendação aprovada (a recomendação passa a ATIVA)
  recomendacaoId String?
  recomendacao   Recomendacao? @relation(fields: [recomendacaoId], references: [id], onDelete: Restrict)

  registradoPorId String?
  registradoPor   User?    @relation("MovimentacaoRegistradaPor", fields: [registradoPorId], references: [id])
  criadoEm        DateTime @default(now())

  @@index([clienteId, data])
  @@index([data])
  @@index([produtoId])
  @@map("movimentacoes")
}

// ============================================================
// LEADS / PIPELINE COMERCIAL
// ============================================================

enum EstagioPipeline {
  PROSPECCAO
  QUALIFICACAO
  PROPOSTA
  NEGOCIACAO
  FECHADO
  PERDIDO
}

model Lead {
  id            String          @id @default(cuid())
  nome          String
  email         String?
  telefone      String?
  origem        String // "Indicação", "Inbound", "Evento", "LinkedIn"
  estagio       EstagioPipeline @default(PROSPECCAO)
  valorEstimado Decimal         @default(0) @db.Decimal(18, 2)
  observacoes   String?

  responsavelId String?
  responsavel   User?   @relation("LeadResponsavel", fields: [responsavelId], references: [id])

  // Quando vira cliente, aponta para o registro. @unique: cada cliente nasce de
  // no máximo um lead (e o lead converte uma vez só).
  clienteId String?  @unique
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  fechadoEm DateTime?

  // histórico de mudanças de estágio
  estagioHistorico EstagioHistorico[]

  @@index([estagio, responsavelId])
  @@index([createdAt])
  @@map("leads")
}

model EstagioHistorico {
  id       String          @id @default(cuid())
  leadId   String
  lead     Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  estagio  EstagioPipeline
  notas    String?
  criadoEm DateTime        @default(now())

  @@index([leadId, criadoEm])
  @@map("estagio_historico")
}

// ============================================================
// PRODUTOS FINANCEIROS
// ============================================================

enum CategoriaProduto {
  RENDA_FIXA
  RENDA_VARIAVEL
  FUNDOS
  PREVIDENCIA
  ESTRUTURADOS
  CAMBIO
}

enum Tributacao {
  TRIBUTADO
  ISENTO
  INCENTIVADO
}

model Produto {
  id               String           @id @default(cuid())
  nome             String
  emissor          String
  categoria        CategoriaProduto
  rentabilidadeAno Decimal          @db.Decimal(6, 2) // % a.a.
  risco            Int // 1-5
  tributacao       Tributacao       @default(TRIBUTADO)
  perfilMinimo     PerfilInvestidor
  liquidez         String // "D+0", "D+30", "Vencimento"
  taxaAdmin        Decimal?         @db.Decimal(5, 2)
  taxaPerformance  Decimal?         @db.Decimal(5, 2)
  ticker           String?          @unique
  ativo            Boolean          @default(true)
  descricao        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recomendacoes Recomendacao[]
  posicoes      Posicao[]
  movimentacoes Movimentacao[]

  @@index([categoria, ativo])
  @@index([perfilMinimo])
  @@map("produtos")
}

// ============================================================
// SUITABILITY (questionário de perfil do investidor)
// ============================================================

model Suitability {
  id        String  @id @default(cuid())
  clienteId String
  // Restrict: histórico de suitability é registro regulatório (CVM 30) e não
  // pode sumir junto com o cliente. Cliente é inativado, não apagado.
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  // Respostas raw do questionário (JSON com chaves perguntaId → resposta)
  respostas Json

  // Pontuação calculada e perfil resultante
  pontuacao          Int
  perfilCalculado    PerfilInvestidor
  versaoQuestionario String           @default("v1")

  validoAte     DateTime // suitability tem validade (geralmente 24 meses)
  aplicadoEm    DateTime @default(now())
  aplicadoPorId String?
  aplicadoPor   User?    @relation("SuitabilityAplicador", fields: [aplicadoPorId], references: [id], onDelete: SetNull)

  @@index([clienteId, aplicadoEm])
  @@map("suitability")
}

// ============================================================
// RECOMENDAÇÕES (geradas pela IA Engine)
// ============================================================

enum StatusRecomendacao {
  PENDENTE
  APROVADA
  RECUSADA
  ATIVA
  EXPIRADA
}

model Recomendacao {
  id        String  @id @default(cuid())
  clienteId String
  // Restrict: trilha de recomendações aprovadas/recusadas é evidência de
  // auditoria e não pode ser apagada em cascata.
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  score         Decimal @db.Decimal(4, 3) // 0.000 - 1.000
  justificativa String // explicação humanizada do motor de IA
  payload       Json // detalhes do scoring (regras aplicadas, features, pesos)

  status StatusRecomendacao @default(PENDENTE)

  aprovadoPorId String?
  aprovadoPor   User?     @relation("RecomendacaoAprovador", fields: [aprovadoPorId], references: [id])
  aprovadoEm    DateTime?
  recusaMotivo  String?

  geradoEm DateTime  @default(now())
  expiraEm DateTime?

  movimentacoes Movimentacao[]

  @@index([clienteId, status])
  @@index([status, geradoEm])
  @@index([produtoId])
  @@map("recomendacoes")
}

// ============================================================
// INTERAÇÕES (histórico de contato com cliente)
// ============================================================

enum TipoInteracao {
  EMAIL
  LIGACAO
  REUNIAO
  WHATSAPP
  TAREFA
  NOTA
}

model Interacao {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  autorId   String
  autor     User    @relation(fields: [autorId], references: [id])

  tipo    TipoInteracao
  assunto String
  resumo  String?
  data    DateTime      @default(now())

  metadata Json? // ex: duração da ligação, anexos, link da call

  createdAt DateTime @default(now())

  @@index([clienteId, data(sort: Desc)])
  @@index([autorId, data(sort: Desc)])
  @@map("interacoes")
}

// ============================================================
// AUDITORIA (trilha completa de mudanças sensíveis)
// ============================================================

enum AcaoAuditoria {
  CRIACAO
  ATUALIZACAO
  EXCLUSAO
  LOGIN
  APROVACAO_RECOMENDACAO
  RECUSA_RECOMENDACAO
  APROVACAO_CARTEIRA
  EXPORTACAO_DADOS
  ACESSO_DADO_SENSIVEL
  LOGOUT
  LOGIN_FALHA
  GERACAO_RECOMENDACAO
  APLICACAO_SUITABILITY
  REUSO_REFRESH_TOKEN
  ALTERACAO_SENHA
  MFA_ATIVACAO
  MFA_DESATIVACAO
  MFA_FALHA
  MFA_USO_RECUPERACAO
  REDEFINICAO_ACESSO
}

model Auditoria {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  acao       AcaoAuditoria
  entidade   String // ex: "Cliente", "Recomendacao"
  entidadeId String?
  diff       Json? // before/after pra updates

  ip        String?
  userAgent String?
  // Correlação com os logs de acesso (header X-Request-Id)
  requestId String?

  criadoEm DateTime @default(now())

  @@index([userId, criadoEm])
  @@index([entidade, entidadeId])
  @@index([acao, criadoEm])
  @@map("auditoria")
}
